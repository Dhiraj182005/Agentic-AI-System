# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# Authentication (JWT)
JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/aidebate

# Redis
REDIS_URL=redis://redis:6379/0

# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=Enter_YOUR_KEY
GROQ_MODEL=ENTER_MODEL_NAme
LLM_TIMEOUT_SECONDS=60

# Evidence
EVIDENCE_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Fact checking
GOOGLE_FACT_CHECK_API_KEY=

# Frontend
FRONTEND_URL=http://localhost:5173
