# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Authentication (JWT)
JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/aidebate

# Redis
REDIS_URL=redis://redis:6379/0

# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=60
# Optional: comma-separated Groq models used in order when the current model's
# DAILY quota is exhausted (each Groq model has its own quota).
GROQ_FALLBACK_MODELS=
# Retries for transient provider errors (429, 5xx, timeouts): exponential
# backoff with jitter; Retry-After is honored, longer waits fail fast.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_RETRY_MAX_DELAY_SECONDS=60
# Output tokens per debate turn. Reasoning models (openai/gpt-oss-*) spend
# part of this on hidden reasoning; an empty answer is retried with a doubled
# budget up to the ceiling.
DEBATE_MAX_RESPONSE_TOKENS=2048
# Word limits per structured turn (all fields together).
DEBATE_OPENING_WORD_LIMIT=200
DEBATE_REBUTTAL_WORD_LIMIT=180
DEBATE_CLOSING_WORD_LIMIT=160
LLM_MAX_OUTPUT_TOKENS_CEILING=8192
# Panel and budget limits (turns = agents x rounds; token estimate =
# turns x (2000 + DEBATE_MAX_RESPONSE_TOKENS)).
DEBATE_MAX_AGENTS=6
DEBATE_MAX_SPECIALISTS=3
DEBATE_MAX_TURNS=40
DEBATE_TOKEN_BUDGET=250000
# Identical topic analyses are served from Redis for this many seconds.
RECOMMENDATION_CACHE_TTL_SECONDS=900
# Running debates keep a Redis heartbeat; a running debate whose heartbeat
# expired is marked failed (interrupted) and can be resumed. Without Redis,
# a debate with no update for DEBATE_STALE_AFTER_SECONDS counts as stale.
DEBATE_HEARTBEAT_TTL_SECONDS=90
DEBATE_STALE_AFTER_SECONDS=1800

# Evidence
EVIDENCE_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Published fact-checks (Google Fact Check Tools API, complements Tavily).
# Server-side only: put the real key in the root .env for Compose, never in the
# frontend. Leave empty to skip the fact-check stage (analysis continues).
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_LANGUAGE=en
GOOGLE_FACT_CHECK_TIMEOUT_SECONDS=10
GOOGLE_FACT_CHECK_MAX_RESULTS=5
GOOGLE_FACT_CHECK_CONCURRENCY=3

# Frontend
FRONTEND_URL=http://localhost:5173

# Demo login (optional, off by default)
# Shows "Fill Demo Credentials" / "Login with Demo Account" on the login page.
# Use a dedicated, throwaway account - never a real user or an administrator.
# After setting these, create the account once with: python seed.py --demo
DEMO_ACCOUNT_ENABLED=false
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

# Post-debate analysis: 0 verifies all factual claim occurrences.
AUTO_ANALYSIS_AFTER_DEBATE=true
ANALYSIS_MAX_VERIFIED_CLAIMS=0
ANALYSIS_MESSAGE_CONCURRENCY=1
ANALYSIS_STALE_SECONDS=1200
