# Copy to .env.production. Never commit the filled file.
APP_ENV=production
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Replace PASSWORD with the respective generated password. For these URLs,
# use URL-safe random hex passwords, or percent-encode reserved characters.
DATABASE_URL=postgresql+asyncpg://maves:PASSWORD@db:5432/maves
REDIS_URL=redis://:PASSWORD@redis:6379/0
FRONTEND_URL=https://maves.example.com
VITE_API_URL=https://api.maves.example.com
DEMO_ACCOUNT_ENABLED=false
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
TAVILY_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
AUTO_ANALYSIS_AFTER_DEBATE=true
ANALYSIS_MAX_VERIFIED_CLAIMS=0
ANALYSIS_MESSAGE_CONCURRENCY=1
